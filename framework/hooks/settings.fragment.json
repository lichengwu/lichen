{
  "_comment": "框架 hooks 注册片段（参考）。实际安装请跑 framework install-hooks——它会把你这个 clone 的绝对路径填进去，并合并进目标 settings.json（带备份、幂等）。timeout 为 harness 硬上限，宽于 NFR-1 预算 2~4 倍防慢机器误杀；违约由 tests 发现。${LICHEN_HOME:-...} 形式兼容经过 shell 的 runner；不经过 shell 的 runner 用 install-hooks --plain。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${LICHEN_HOME:-/path/to/skills}/framework/hooks/session_start.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${LICHEN_HOME:-/path/to/skills}/framework/hooks/session_start.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${LICHEN_HOME:-/path/to/skills}/framework/hooks/user_prompt_submit.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${LICHEN_HOME:-/path/to/skills}/framework/hooks/post_tool_use.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${LICHEN_HOME:-/path/to/skills}/framework/hooks/stop.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
